{
  "expo": {
    "name": "Codexgram",
    "slug": "codexgram",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/codexgram-icon.png",
    "scheme": "codexgram",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/codexgram-icon.png",
      "bundleIdentifier": "dev.gek007.codexgram",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6841D9",
        "foregroundImage": "./assets/images/codexgram-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.gek007.codexgram"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/codexgram-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6841D9",
          "image": "./assets/images/codexgram-icon.png",
          "imageWidth": 104
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Codexgram uses your photos when you choose an image to share.",
          "cameraPermission": "Codexgram uses the camera to capture a photo you want to share.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "gek007",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "69121ad9-579a-42ba-9d82-820d13044cfc"
      }
    }
  }
}
